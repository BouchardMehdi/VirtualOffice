{
  "name": "virtualoffice",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "prisma": { "mysql2": "3.24.4" }
  },
  "scripts": {
    "dev:client": "npm run dev --workspace @virtualoffice/client",
    "dev:server": "npm run dev --workspace @virtualoffice/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace @virtualoffice/server",
    "prisma:validate": "npm run prisma:validate --workspace @virtualoffice/server"
  }
}
