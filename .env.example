# Identifiants uniquement pour la demonstration locale.
POSTGRES_USER=virtualoffice
POSTGRES_PASSWORD=virtualoffice_demo
POSTGRES_DB=virtualoffice
POSTGRES_PORT=5432

# Connexion du serveur lance directement sur la machine (hors Docker).
# Docker Compose remplace localhost par le nom du service database.
DATABASE_URL=postgresql://virtualoffice:virtualoffice_demo@localhost:5432/virtualoffice?schema=public
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Cible du proxy Vite en developpement local, jamais envoyee au navigateur.
API_PROXY_TARGET=http://localhost:4000
